# ── Live Grok tutoring (server-side only) ───────────────────────────────────
# SuperGrok / xAI subscription does NOT auto-inject into this app.
# You need an API key from the same xAI account:
#
#   1. Open https://console.x.ai  (sign in with the SuperGrok / xAI account)
#   2. Create an API key
#   3. Paste it below (never commit .env — it is gitignored)
#   4. Restart the Grok Tutor dev server (close DEV window, re-run desktop launcher)
#
# Without a key, Learn still works with offline pack-based educational replies.

XAI_API_KEY=

# Optional alias:
# GROK_API_KEY=

# Model (chat completions on https://api.x.ai/v1)
XAI_MODEL=grok-4.5

# Optional database URL for auth/progress if you enable server persistence:
# DATABASE_URL=
