{
  "name": "grok-tutor",
  "private": false,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8085",
    "build": "vite build && npm run db:migrate",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview --host 0.0.0.0 --port 8085",
    "typecheck": "tsc --noEmit",
    "audit:corpus": "tsx scripts/corpus-quality-audit.mts",
    "audit:polish": "tsx scripts/corpus-polish-audit.mts",
    "audit:polish:public": "tsx scripts/corpus-polish-audit.mts --tier public --batch-size 1000",
    "corpus:clean": "tsx scripts/corpus-polish-clean.mts",
    "corpus:clean-audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Run-Corpus-Clean-And-Audit-Complete.ps1",
    "corpus:pace": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Keep-Corpus-Polish-Pace.ps1",
    "corpus:training-queue": "tsx scripts/build-training-queue.mts --export",
    "corpus:training-polish": "tsx scripts/polish-training-queue.mts",
    "corpus:training-pipeline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Run-Training-Material-Pipeline.ps1",
    "corpus:harvest-all": "tsx scripts/harvest-all-unique-lessons.mts --export",
    "corpus:polish-all-uniques": "tsx scripts/polish-all-uniques.mts",
    "corpus:all-lessons-pipeline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Run-All-Lessons-Training-Pipeline.ps1",
    "test:e2e50": "node scripts/e2e-50.mjs",
    "test:cad100": "node scripts/e2e-cad-100.mjs",
    "test:responsive50": "node scripts/stress-responsive-50.mjs",
    "test:hive-dual": "node scripts/stress-hive-dualmode.mjs",
    "test:sim200": "node scripts/sim-feature-cycles-200.mjs",
    "test:sim1h": "node scripts/sim-observable-1h.mjs",
    "test:shape": "node scripts/e2e-shape-contract.mjs",
    "test:idle-labels": "tsx scripts/assert-idle-comb-labels.mts",
    "test:path-play": "tsx scripts/assert-path-play.mts",
    "test:learner-chrome": "tsx scripts/assert-learner-desk-chrome.mts",
    "test:help-progress": "tsx scripts/assert-help-progress.mts",
    "test:reasoning": "npm.cmd exec -- tsx scripts/reasoning-track-corpus.mts",
    "test:spectrum": "npm.cmd exec -- tsx scripts/full-spectrum-reasoning-pipeline.mts",
    "test:morning": "node scripts/e2e-morning-suite.mjs",
    "audit:public": "node scripts/audit-public-claims.mjs",
    "corpus:reasoning": "npm.cmd exec -- tsx scripts/reasoning-track-corpus.mts",
    "corpus:spectrum": "npm.cmd exec -- tsx scripts/full-spectrum-reasoning-pipeline.mts",
    "soak:balanced": "tsx scripts/continuous-balanced-soak.mts --sim-only",
    "soak:balanced:full": "tsx scripts/continuous-balanced-soak.mts",
    "soak:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Keep-Balanced-Soak.ps1",
    "corpus:dedupe": "tsx scripts/dedupe-corpus.mts",
    "corpus:dedupe:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Keep-Corpus-Dedupe.ps1",
    "open:observe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Open-Quad-Observe.ps1",
    "keep:server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Keep-Tutor-Server.ps1",
    "test:normie-sim": "node scripts/release-normie-sim.mjs --cycles 4 --streak 4 --public http://127.0.0.1:8085",
    "gen:cad100": "node scripts/generate-cad-samples-100.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:partmode20": "node scripts/e2e-partmode-20.mjs",
    "gen:partmode20": "node scripts/generate-partmode-samples-20.mjs",
    "start:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-Grok-Tutor-Release.ps1",
    "tutor:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-Grok-Tutor-Release.ps1",
    "test:release": "node scripts/run-release-stress-suite.mjs",
    "test:release:quick": "node scripts/run-release-stress-suite.mjs --quick",
    "test:normie-sim:public": "node scripts/release-normie-sim.mjs --cycles 4 --streak 4 --public https://gt2samples.grok.me",
    "sim:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-Full-Sim-Instance.ps1",
    "sim:full:no-ui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Start-Full-Sim-Instance.ps1 -NoObserve"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@hookform/resolvers": "^5.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.160.0",
    "@tanstack/react-start": "^1.160.0",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.160.0",
    "@types/three": "^0.172.0",
    "better-auth": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.172.0",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260603-beta",
    "playwright": "^1.52.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.1.0"
  },
  "description": "Grok Tutor — educational craft learning with thinking tools (AdventureNLearn)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdventureNLearn/Grok-Tutor-AOS-Path.git"
  },
  "bugs": {
    "url": "https://github.com/AdventureNLearn/Grok-Tutor-AOS-Path/issues"
  },
  "homepage": "https://gt2samples.grok.me/"
}
